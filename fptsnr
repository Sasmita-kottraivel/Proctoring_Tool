// ---------------------------------------------------------------------------
void openFlap() {
  Serial.println("Bottle detected -> Opening flap...");
  flapServo.write(SERVO_OPEN_ANGLE);
  flapIsOpen = true;
  flapOpenedAt = millis();
}

void checkFlapAutoClose() {
  if (flapIsOpen && (millis() - flapOpenedAt >= FLAP_OPEN_DURATION)) {
    Serial.println("Closing flap...");
    flapServo.write(SERVO_CLOSED_ANGLE);
    flapIsOpen = false;
  }
}

// ---------------------------------------------------------------------------
// Enrolls a new fingerprint. Requires two good reads of the same finger.
// Stores it at a chosen ID slot (1-127 typically, depending on sensor model).
// ---------------------------------------------------------------------------
void enrollFingerprint() {
  Serial.println("=== FINGERPRINT ENROLL ===");
  Serial.println("Enter an ID number (1-127) to store this fingerprint as, then press Enter:");

  while (!Serial.available()) { delay(50); }
  int id = Serial.parseInt();
  if (id < 1 || id > 127) {
    Serial.println("Invalid ID. Must be 1-127. Aborting.");
    return;
  }

  Serial.print("Enrolling ID #");
  Serial.println(id);

  Serial.println("Place finger on sensor...");
  int p = -1;
  while (p != FINGERPRINT_OK) {
    p = finger.getImage();
    if (p == FINGERPRINT_OK) {
      Serial.println("Image captured.");
    } else if (p == FINGERPRINT_NOFINGER) {
      // just keep waiting
    } else {
      Serial.println("Error capturing image.");
      return;
    }
  }

  p = finger.image2Tz(1);
  if (p != FINGERPRINT_OK) {
    Serial.println("Error converting image. Try again.");
    return;
  }

  Serial.println("Remove finger.");
  delay(2000);
  p = 0;
  while (p != FINGERPRINT_NOFINGER) {
    p = finger.getImage();
  }

  Serial.println("Place same finger again...");
  p = -1;
  while (p != FINGERPRINT_OK) {
    p = finger.getImage();
    if (p == FINGERPRINT_OK) {
      Serial.println("Image captured.");
    } else if (p == FINGERPRINT_NOFINGER) {
      // keep waiting
    } else {
      Serial.println("Error capturing image.");
      return;
    }
  }

  p = finger.image2Tz(2);
  if (p != FINGERPRINT_OK) {
    Serial.println("Error converting second image. Try again.");
    return;
  }

  p = finger.createModel();
  if (p != FINGERPRINT_OK) {
    Serial.println("Prints did not match each other. Enrollment failed.");
    return;
  }

  p = finger.storeModel(id);
  if (p == FINGERPRINT_OK) {
    Serial.println("Fingerprint enrolled successfully!");
  } else {
    Serial.println("Error storing fingerprint.");
  }
}

// ---------------------------------------------------------------------------
// Scans a finger and tries to match it against enrolled fingerprints.
// ---------------------------------------------------------------------------
void scanAndMatchFingerprint() {
  Serial.println("=== FINGERPRINT SCAN ===");
  Serial.println("Place finger on sensor...");

  int p = -1;
  unsigned long startTime = millis();
  while (p != FINGERPRINT_OK) {
    p = finger.getImage();
    if (millis() - startTime > 10000) {
      Serial.println("Timed out waiting for finger.");
      return;
    }
  }

  p = finger.image2Tz();
  if (p != FINGERPRINT_OK) {
    Serial.println("Error converting image.");
    return;
  }

  p = finger.fingerSearch();
  if (p == FINGERPRINT_OK) {
    Serial.print("Match found! ID #");
    Serial.print(finger.fingerID);
    Serial.print(" with confidence ");
    Serial.println(finger.confidence);
  } else {
    Serial.println("No match found.");
  }
}
